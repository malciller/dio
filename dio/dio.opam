opam-version: "2.1"
name: "dio"
version: "0.0.0"
maintainer: "malciller@gmail.com"
authors: "Cal Miller"
license: "MIT"
homepage: "https://github.com/mallciller/dio"
dev-repo: "git+https://github.com/malciller/dio.git"
synopsis: "Trading engine"
depends: [
  "ocaml" {>= "5.2"}
  "dune"  {>= "3.13"}
  "lwt" "lwt_ppx"
  "yojson" "ppx_deriving_yojson"
  "decimal"
  "caqti" "caqti-driver-sqlite3"
  "websocket-lwt"
  "cmdliner"
  "alcotest"
  "prometheus"
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
