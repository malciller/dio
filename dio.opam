# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Dio – trading engine"
maintainer: ["malciller@gmail.com"]
authors: ["Cal Milller"]
license: "MIT"
homepage: "https://github.com/malciller/dio"
bug-reports: "https://github.com/malciller/dio/issues"
depends: [
  "ocaml" {>= "4.14" & < "5.0"} 
  "dune" {>= "3.13"}
  "lwt"
  "lwt_ppx"
  "yojson"
  "ppx_deriving_yojson"
  "decimal"
  "caqti"
  "caqti-driver-sqlite3"
  "websocket-lwt"
  "cmdliner"
  "alcotest"
  "prometheus"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/malciller/dio.git"
