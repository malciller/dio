# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Dio – trading engine"
maintainer: ["malciller@gmail.com"]
authors: ["Cal Miller"]
license: "MIT"
homepage: "https://github.com/malciller/dio"
bug-reports: "https://github.com/malciller/dio/issues"
depends: [
  "lwt_ssl"
  "tls-lwt"
  "conduit-lwt-unix"
  "dune" {>= "3.13"}
  "decimal"
  "lwt"
  "lwt_ppx"
  "lwt_log"
  "yojson"
  "ppx_deriving_yojson"
  "sqlite3"
  "websocket-lwt-unix"
  "cohttp-lwt-unix"
  "alcotest"
  "alcotest-lwt"
  "dotenv"
  "cstruct"
  "notty"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/malciller/dio.git"
